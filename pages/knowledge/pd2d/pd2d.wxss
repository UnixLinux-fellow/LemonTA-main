/* pages/knowledge/pd2d/pd2d.wxss */

.page {
  width: 100vw;
  height: 100vh;
  background: #2a2a2a;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 导航栏 ===== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(42, 42, 42, 0.92);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 0 16rpx;
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  flex-shrink: 0;
}

.nav-back:active {
  background: rgba(255, 255, 255, 0.1);
}

.nav-back-icon {
  font-size: 52rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.5rpx;
  margin-left: 8rpx;
}

.nav-mode {
  margin-left: auto;
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(252, 151, 0, 0.15);
  border: 1rpx solid rgba(252, 151, 0, 0.3);
}

.nav-mode:active {
  background: rgba(252, 151, 0, 0.3);
}

.nav-mode-text {
  font-size: 24rpx;
  color: #FC9700;
  font-weight: 600;
}

/* ===== Canvas ===== */
.canvas-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 8rpx;
}

.pd2d-canvas {
  border-radius: 4rpx;
}

/* ===== 底部控制栏 ===== */
.bottom-bar {
  background: rgba(42, 42, 42, 0.95);
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  padding: 12rpx 20rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.bar-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.bar-row:last-child {
  margin-bottom: 0;
}

.bar-sep {
  color: rgba(255, 255, 255, 0.15);
  font-size: 24rpx;
  margin: 0 4rpx;
}

/* ===== 按钮 ===== */
.btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.btn:active {
  opacity: 0.85;
}

.btn-primary {
  background: linear-gradient(135deg, #FFB140 0%, #FC9700 100%);
  color: #ffffff;
}

.btn-outline {
  background: transparent;
  color: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.btn-outline:active {
  background: rgba(255, 255, 255, 0.06);
}

.btn-small {
  flex: 1;
  padding: 14rpx 0;
  font-size: 24rpx;
}

.btn-place {
  flex: 1;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #FFB140 0%, #FC9700 100%);
  border-radius: 16rpx;
  text-align: center;
}

.btn-place:active {
  opacity: 0.85;
}

.btn-place text {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

/* ===== 柜体选择芯片 ===== */
.chip {
  padding: 10rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.chip text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  font-weight: 500;
}

.chip:active {
  background: rgba(255, 255, 255, 0.12);
}

.chip-active {
  background: rgba(252, 151, 0, 0.15);
  border-color: rgba(252, 151, 0, 0.3);
}

.chip-active text {
  color: #FC9700;
  font-weight: 600;
}

.cabinet-row {
  justify-content: center;
}

/* ===== 墙面尺寸输入行 ===== */
.dims-row {
  gap: 8rpx;
}

.dims-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  flex-shrink: 0;
}

.dims-input {
  width: 100rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 10rpx;
  padding: 0 12rpx;
  font-size: 26rpx;
  color: #FC9700;
  text-align: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

/* ===== 空状态 ===== */
.hint {
  position: absolute;
  bottom: 280rpx;
  left: 0;
  right: 0;
  text-align: center;
  pointer-events: none;
}

.hint text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.3);
}
