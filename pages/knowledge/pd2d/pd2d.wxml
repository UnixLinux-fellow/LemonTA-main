<!--pages/knowledge/pd2d/pd2d.wxml-->
<view class="page">
  <!-- 导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar" style="height: {{navBarHeight}}px;">
      <view class="nav-back" bindtap="goBack">
        <text class="nav-back-icon">‹</text>
      </view>
      <text class="nav-title">PD2D</text>
      <view class="nav-mode" bindtap="switchMode" wx:if="{{hasPhoto}}">
        <text class="nav-mode-text">{{mode === 'corners' ? '摆放' : '调角'}}</text>
      </view>
    </view>
  </view>

  <!-- Canvas -->
  <view class="canvas-wrapper" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    <canvas
      type="2d"
      id="pd2dCanvas"
      class="pd2d-canvas"
      style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
      bindtouchstart="onCanvasTouchStart"
      bindtouchmove="onCanvasTouchMove"
      bindtouchend="onCanvasTouchEnd"
    ></canvas>
  </view>

  <!-- 墙面尺寸弹窗 -->
  <view class="modal-mask" wx:if="{{showWallModal}}" bindtap="closeWallModal">
    <view class="modal-content" catchtap="">
      <text class="modal-title">墙面尺寸</text>
      <view class="modal-row">
        <text class="modal-label">宽度 (cm)</text>
        <input class="modal-input" type="number" value="{{wallWidth}}" bindinput="onWallWidthInput" />
      </view>
      <view class="modal-row">
        <text class="modal-label">高度 (cm)</text>
        <input class="modal-input" type="number" value="{{wallHeight}}" bindinput="onWallHeightInput" />
      </view>
      <view class="modal-hint">
        <text>宽度 44-1000cm · 高度 232-400cm</text>
      </view>
      <view class="modal-btn" bindtap="closeWallModal">
        <text>确认</text>
      </view>
    </view>
  </view>

  <!-- 底部控制栏 -->
  <view class="bottom-bar">
    <!-- 照片按钮行 -->
    <view class="bar-row">
      <view class="btn btn-primary" bindtap="choosePhoto" style="flex:2;">
        <text>{{hasPhoto ? '更换照片' : '上传照片'}}</text>
      </view>
      <view class="btn btn-outline" bindtap="openWallModal">
        <text>墙面 {{wallWidth}}×{{wallHeight}}</text>
      </view>
    </view>

    <!-- 柜体选择行 (仅照片模式) -->
    <view class="bar-row" wx:if="{{hasPhoto}}">
      <!-- 类型选择 -->
      <view class="chip {{selectedType === 'a' ? 'chip-active' : ''}}" bindtap="selectType" data-type="a">
        <text>A型</text>
      </view>
      <view class="chip {{selectedType === 'b' ? 'chip-active' : ''}}" bindtap="selectType" data-type="b">
        <text>B型</text>
      </view>
      <view class="chip {{selectedType === 'c' ? 'chip-active' : ''}}" bindtap="selectType" data-type="c">
        <text>C型</text>
      </view>
      <view class="chip {{selectedType === 'd' ? 'chip-active' : ''}}" bindtap="selectType" data-type="d">
        <text>D型</text>
      </view>
      <text class="bar-sep">|</text>
      <!-- 宽度选择 -->
      <view class="chip {{selectedWidth === 50 ? 'chip-active' : ''}}" bindtap="selectWidth" data-width="50">
        <text>50cm</text>
      </view>
      <view class="chip {{selectedWidth === 100 ? 'chip-active' : ''}}" bindtap="selectWidth" data-width="100">
        <text>100cm</text>
      </view>
    </view>

    <!-- 操作按钮行 -->
    <view class="bar-row">
      <view class="btn btn-outline" bindtap="removePhoto" wx:if="{{hasPhoto}}">
        <text>移除照片</text>
      </view>
      <view class="btn btn-outline" bindtap="resetCorners" wx:if="{{hasPhoto && mode === 'corners'}}">
        <text>重置角点</text>
      </view>
      <view class="btn btn-outline" bindtap="removeLastModule" wx:if="{{hasPhoto && modules.length > 0}}">
        <text>撤销柜体</text>
      </view>
    </view>
  </view>

  <!-- 空状态提示 -->
  <view class="hint" wx:if="{{!hasPhoto}}">
    <text>上传墙面照片 · 设置墙面尺寸 · 摆放柜体</text>
  </view>
</view>
