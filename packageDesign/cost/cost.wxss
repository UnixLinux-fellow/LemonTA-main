/* pages/design/cost/cost.wxss */

.container {
  min-height: 100vh;
  position: relative;
}

/* 导航栏覆盖 */
.custom-nav {
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(10px);
}

.nav-back-icon {
  font-size: 44rpx;
  font-weight: bold;
}

.page-content {
  position: relative;
  z-index: 1;
  padding: 0 30rpx 200rpx;
}

/* ========== 配置选择 ========== */
.config-section {
  padding-bottom: 40rpx;
}

/* 设计信息卡 */
.design-info-card {
  background: rgba(255,255,255,0.92);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.design-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
}

.design-desc {
  font-size: 24rpx;
  color: #999;
}

.config-group {
  background: rgba(255,255,255,0.92);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.config-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.config-hint {
  font-size: 22rpx;
  color: #aaa;
  display: block;
  margin-top: 6rpx;
  margin-bottom: 20rpx;
}

.config-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.config-option {
  padding: 14rpx 28rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  background: rgba(255,255,255,0.8);
  transition: all 0.2s;
}

.config-option.active {
  border-color: #FC9700;
  color: #FC9700;
  background: rgba(252,151,0,0.08);
  font-weight: bold;
}

.action-bar {
  margin-top: 40rpx;
}

.btn-confirm {
  background: #FC9700;
  color: #fff;
  border-radius: 50rpx;
  padding: 28rpx 0;
  font-size: 34rpx;
  font-weight: bold;
  border: none;
  width: 100%;
}

/* ========== 成本结果 ========== */
.result-section {
  padding-bottom: 40rpx;
}

/* 结果标题 */
.result-title-area {
  text-align: center;
  margin-bottom: 24rpx;
}

.result-design-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
}

.result-subtitle {
  font-size: 28rpx;
  color: #666;
  display: block;
}

/* 设计效果预览区域 */
.design-preview-area {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

/* 顶部渲染图（config/result 共用） */
.design-preview-top {
  margin-bottom: 24rpx;
}

/* 完整设计效果渲染图 */
.design-preview-full {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-full-img {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
}

.design-preview-scroll {
  width: 100%;
  white-space: nowrap;
}

.design-preview-row {
  display: inline-flex;
  align-items: flex-end;
  gap: 0;
  padding: 0 4rpx;
}

.preview-thumb-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
}

.preview-thumb-stack {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-thumb-gap {
  width: 120rpx;
  height: 50rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-thumb-gap-img {
  width: 100%;
  height: 100%;
}

.preview-thumb-main {
  width: 120rpx;
  height: 160rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-thumb-main-img {
  width: 100%;
  height: 100%;
}

/* 成本汇总卡片 */
.cost-summary-card {
  background: rgba(255,255,255,0.96);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  margin-bottom: 16rpx;
}

.summary-header-left {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.summary-header-right {
  font-size: 26rpx;
  color: #999;
}

/* 模块成本块 */
.module-cost-block {
  margin-bottom: 8rpx;
}

.module-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  margin-top: 16rpx;
}

.module-title-left {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.module-title-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #FC9700;
}

.module-title-amount {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.module-detail-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #999;
  font-size: 24rpx;
}

.link-arrow {
  font-size: 24rpx;
  color: #999;
}

/* 四项费用网格 */
.module-cost-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx 40rpx;
  padding: 8rpx 0 16rpx;
}

.cost-grid-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.cost-grid-label {
  font-size: 26rpx;
  color: #666;
}

.cost-grid-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.module-divider {
  height: 1rpx;
  background: #e8e8e8;
  margin: 8rpx 0;
}

/* 总成本预估 */
.grand-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #e8e8e8;
}

.grand-total-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.grand-total-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #FC9700;
}

/* 下载按钮 */
.download-bar {
  margin-top: 30rpx;
}

/* 一键下载 / 更换配置 两个按钮共享的基础样式（保证高度、字号、圆角完全一致，视觉对齐） */
.btn-action {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-sizing: border-box;
}

.btn-action::after {
  border: none;
}

.btn-download {
  background: #FC9700;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(252, 151, 0, 0.28);
}

/* 更换配置按钮 */
.reconfig-bar {
  margin-top: 20rpx;
}

.btn-reconfig {
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid #e0e0e0;
  color: #666;
}

/* ========== 模块明细弹窗 ========== */
.detail-modal {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.detail-modal-mask {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.4);
}

.detail-modal-content {
  position: relative;
  width: 94%;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  z-index: 1;
  overflow: hidden;
}

.detail-scroll {
  flex: 1;
  padding: 0 30rpx 30rpx;
  max-height: 60vh;
  overflow-x: hidden;
}

.detail-header-fixed {
  padding: 30rpx 30rpx 0;
}

.detail-modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.detail-summary-bar {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.detail-summary-item {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.detail-summary-label {
  font-size: 26rpx;
  color: #666;
}

.detail-summary-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.detail-modal-line {
  height: 2rpx;
  background: #333;
  margin-top: 16rpx;
  margin-bottom: 0;
}

/* 板材表格 */
.detail-section-title-center {
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin: 24rpx 0 16rpx;
}

.board-table {
  width: 100%;
  margin-bottom: 24rpx;
}

.board-table-header {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #333;
  font-size: 22rpx;
  color: #666;
  font-weight: bold;
}

.board-table-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 22rpx;
  color: #333;
}

.bt-col-name {
  width: 14%;
  text-align: center;
  font-size: 22rpx;
  white-space: pre-line;
  flex-shrink: 0;
  box-sizing: border-box;
}

.bt-col-num {
  width: 11%;
  text-align: center;
  font-size: 22rpx;
  white-space: pre-line;
  flex-shrink: 0;
  box-sizing: border-box;
}

.bt-col-total {
  width: 14%;
  text-align: right;
  font-size: 22rpx;
  font-weight: bold;
  white-space: pre-line;
  flex-shrink: 0;
  padding-right: 4rpx;
  box-sizing: border-box;
}

/* 五金表格 */
.hw-table {
  width: 100%;
  margin-bottom: 24rpx;
}

.hw-table-header {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #333;
  font-size: 22rpx;
  color: #666;
  font-weight: bold;
}

.hw-table-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 22rpx;
  color: #333;
}

.hw-col-cat {
  width: 14%;
  text-align: center;
  font-size: 22rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.hw-col-name {
  width: 44%;
  font-size: 22rpx;
  padding-right: 8rpx;
  word-break: break-all;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.hw-col-num {
  width: 11%;
  text-align: center;
  font-size: 22rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.hw-col-total {
  width: 14%;
  text-align: right;
  font-size: 22rpx;
  font-weight: bold;
  flex-shrink: 0;
  padding-right: 4rpx;
  box-sizing: border-box;
}

/* 关闭按钮 */
.detail-close-bar {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: center;
}

.detail-close-btn {
  padding: 12rpx 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
}

/* ========== 下载成功弹窗 ========== */
.download-modal {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
}

.download-modal-mask {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.4);
}

.download-modal-content {
  position: relative;
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx 40rpx;
  text-align: center;
  z-index: 1;
}

.download-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.download-modal-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 24rpx;
}

/* 已复制的链接，展示给用户看一眼 */
.download-modal-link {
  background: #F6F7F9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 30rpx;
  word-break: break-all;
}

.download-modal-link-text {
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
}

/* 弹窗底部双按钮行 */
.download-modal-actions {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.download-modal-btn {
  flex: 1;
  padding: 26rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease;
}

.download-modal-btn:active {
  background: #fafafa;
}

.download-modal-btn-secondary {
  border-right: 1rpx solid #f0f0f0;
}

.download-modal-btn-text-secondary {
  font-size: 30rpx;
  font-weight: 500;
  color: #86868b;
}

.download-modal-btn-text-primary {
  font-size: 30rpx;
  font-weight: 700;
  color: #FC9700;
}
