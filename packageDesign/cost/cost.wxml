<!--pages/design/cost/cost.wxml-->
<wxs src="../../utils/assets.wxs" module="assets" />
<wxs module="fmt">
  module.exports = {
    toFixed: function(val, n) {
      if (val === undefined || val === null) return '0';
      var num = val - 0;
      if (num !== num) return '0';
      var d = n || 1;
      var p = 1;
      for (var i = 0; i < d; i++) { p = p * 10; }
      var r = Math.round(num * p) / p;
      var s = '' + r;
      var dot = s.indexOf('.');
      if (dot < 0) { s = s + '.'; dot = s.length - 1; }
      while (s.length - dot - 1 < d) { s = s + '0'; }
      return s;
    }
  }
</wxs>
<view class="container">
  <image class="bg-image" src="{{assets.bg('T3')}}" mode="aspectFill" lazy-load />

  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar" style="height: {{navBarHeight}}px;">
      <view class="nav-back" bindtap="goBack">
        <text class="nav-back-icon">‹</text>
      </view>
      <text class="nav-title">成本透视</text>
    </view>
  </view>

  <view class="page-content" style="padding-top: {{statusBarHeight + navBarHeight + 10}}px;">

    <!-- ========== 顶部渲染图（config/result 共用，始终显示） ========== -->
    <view wx:if="{{previewImage}}" class="design-preview-area design-preview-top">
      <image class="preview-full-img" src="{{previewImage}}" mode="aspectFit" lazy-load />
    </view>

    <!-- ========== 步骤一：配置选择 ========== -->
    <view wx:if="{{step === 'config'}}" class="config-section">
      <!-- 设计信息 -->
      <view class="design-info-card">
        <text class="design-name">{{designName}}</text>
        <text class="design-desc">{{designInfo}}</text>
      </view>

      <!-- 板材品牌 -->
      <view class="config-group">
        <text class="config-label">板材品牌</text>
        <text class="config-hint">柜体板材的品牌选择</text>
        <view class="config-options">
          <view class="config-option {{board === item ? 'active' : ''}}" 
                wx:for="{{boardOptions}}" wx:key="*this"
                bindtap="selectConfig" data-field="board" data-value="{{item}}">
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 门板材质 -->
      <view class="config-group">
        <text class="config-label">门板材质</text>
        <text class="config-hint">门板表面材质（加价项）</text>
        <view class="config-options">
          <view class="config-option {{doorMaterial === item ? 'active' : ''}}" 
                wx:for="{{doorMaterialOptions}}" wx:key="*this"
                bindtap="selectConfig" data-field="doorMaterial" data-value="{{item}}">
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 门板工艺 -->
      <view class="config-group">
        <text class="config-label">门板工艺</text>
        <text class="config-hint">门板造型工艺（加价项）</text>
        <view class="config-options">
          <view class="config-option {{doorCraft === item ? 'active' : ''}}" 
                wx:for="{{doorCraftOptions}}" wx:key="*this"
                bindtap="selectConfig" data-field="doorCraft" data-value="{{item}}">
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 五金品牌 -->
      <view class="config-group">
        <text class="config-label">五金品牌</text>
        <text class="config-hint">铰链、滑轨等五金件品牌</text>
        <view class="config-options">
          <view class="config-option {{hardware === item ? 'active' : ''}}" 
                wx:for="{{hardwareOptions}}" wx:key="*this"
                bindtap="selectConfig" data-field="hardware" data-value="{{item}}">
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 照明 -->
      <view class="config-group">
        <text class="config-label">照明</text>
        <text class="config-hint">柜内灯光配置</text>
        <view class="config-options">
          <view class="config-option {{lighting === item ? 'active' : ''}}" 
                wx:for="{{lightingOptions}}" wx:key="*this"
                bindtap="selectConfig" data-field="lighting" data-value="{{item}}">
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 确认按钮 -->
      <view class="action-bar">
        <button class="btn-confirm" bindtap="confirmConfig">计算成本</button>
      </view>
    </view>

    <!-- ========== 步骤二：成本结果 ========== -->
    <view wx:if="{{step === 'result' && costResult}}" class="result-section">

      <!-- 标题区 -->
      <view class="result-title-area">
        <text class="result-design-name">{{designName}}</text>
        <text class="result-subtitle">成本&配件 汇总清单</text>
      </view>

      <!-- 成本汇总卡片 -->
      <view class="cost-summary-card">
        <!-- 表头 -->
        <view class="summary-header">
          <text class="summary-header-left">项目</text>
          <text class="summary-header-right">单项合计</text>
        </view>

        <!-- 各模块成本 -->
        <view class="module-cost-block" wx:for="{{costResult.modules}}" wx:key="index">
          <!-- 模块标题行 -->
          <view class="module-title-row">
            <view class="module-title-left">
              <text class="module-title-name">{{item.name}} 总成本</text>
              <text class="module-title-amount">{{fmt.toFixed(item.totalCost, 1)}}元</text>
            </view>
            <view class="module-detail-link" bindtap="toggleModule" data-index="{{index}}">
              <text>查看模块明细</text>
              <text class="link-arrow">></text>
            </view>
          </view>

          <!-- 四项费用 -->
          <view class="module-cost-grid">
            <view class="cost-grid-item">
              <text class="cost-grid-label">板材合计</text>
              <text class="cost-grid-value">{{fmt.toFixed(item.boardCost, 1)}}元</text>
            </view>
            <view class="cost-grid-item">
              <text class="cost-grid-label">运费</text>
              <text class="cost-grid-value">{{fmt.toFixed(item.shipping, 1)}}元</text>
            </view>
            <view class="cost-grid-item">
              <text class="cost-grid-label">五金配件</text>
              <text class="cost-grid-value">{{fmt.toFixed(item.hardwareCost, 1)}}元</text>
            </view>
            <view class="cost-grid-item">
              <text class="cost-grid-label">安装费</text>
              <text class="cost-grid-value">{{fmt.toFixed(item.installation, 1)}}元</text>
            </view>
          </view>

          <!-- 分隔线（非最后一个模块时显示） -->
          <view class="module-divider" wx:if="{{index < costResult.modules.length - 1}}"></view>
        </view>

        <!-- 总成本预估 -->
        <view class="grand-total-row">
          <text class="grand-total-label">总成本预估</text>
          <text class="grand-total-value">{{costResult.summary.grandTotal}}</text>
        </view>
      </view>

      <!-- 下载按钮：点击唤起网盘链接弹窗 -->
      <view class="download-bar">
        <button class="btn-action btn-download" bindtap="downloadReport">一键下载</button>
      </view>

      <!-- 更换配置按钮 -->
      <view class="reconfig-bar">
        <button class="btn-action btn-reconfig" bindtap="backToConfig">更换配置</button>
      </view>
    </view>
  </view>

  <!-- ========== 模块明细弹窗 ========== -->
  <view class="detail-modal" wx:if="{{expandedModule >= 0 && costResult}}" catchtouchmove="true">
    <view class="detail-modal-mask" bindtap="closeDetail"></view>
    <view class="detail-modal-content">
      <!-- 标题 -->
      <view class="detail-header-fixed">
        <view class="detail-modal-title">
          <text>{{costResult.modules[expandedModule].name}} 成本明细</text>
        </view>
        <!-- 费用汇总 -->
        <view class="detail-summary-bar">
          <view class="detail-summary-item">
            <text class="detail-summary-label">板材合计</text>
            <text class="detail-summary-value">{{fmt.toFixed(costResult.modules[expandedModule].boardCost, 1)}}元</text>
          </view>
          <view class="detail-summary-item">
            <text class="detail-summary-label">运费</text>
            <text class="detail-summary-value">{{fmt.toFixed(costResult.modules[expandedModule].shipping, 1)}}元</text>
          </view>
        </view>
        <view class="detail-summary-bar">
          <view class="detail-summary-item">
            <text class="detail-summary-label">五金配件</text>
            <text class="detail-summary-value">{{fmt.toFixed(costResult.modules[expandedModule].hardwareCost, 1)}}元</text>
          </view>
          <view class="detail-summary-item">
            <text class="detail-summary-label">安装费</text>
            <text class="detail-summary-value">{{fmt.toFixed(costResult.modules[expandedModule].installation, 1)}}元</text>
          </view>
        </view>
        <view class="detail-modal-line"></view>
      </view>

      <scroll-view scroll-y class="detail-scroll">

        <!-- 板材(含加工费) -->
        <view class="detail-section-title-center">板材(含加工费)</view>
        <view class="board-table">
          <!-- 表头 -->
          <view class="board-table-header">
            <text class="bt-col-name">部件</text>
            <text class="bt-col-num">长\ncm</text>
            <text class="bt-col-num">宽\ncm</text>
            <text class="bt-col-num">厚</text>
            <text class="bt-col-num">数量\n块</text>
            <text class="bt-col-num">面积\nm²</text>
            <text class="bt-col-num">单价\n元</text>
            <text class="bt-col-total">总计\n元</text>
          </view>
          <!-- 板材行 -->
          <view class="board-table-row" 
                wx:for="{{costResult.modules[expandedModule].boardDetail}}" 
                wx:key="name"
                wx:if="{{item.qty > 0}}">
            <text class="bt-col-name">{{item.name}}</text>
            <text class="bt-col-num">{{item.l}}</text>
            <text class="bt-col-num">{{item.w}}</text>
            <text class="bt-col-num">{{item.thick}}</text>
            <text class="bt-col-num">{{item.qty}}</text>
            <text class="bt-col-num">{{fmt.toFixed(item.area, 2)}}</text>
            <text class="bt-col-num">{{item.unitPrice}}</text>
            <text class="bt-col-total">{{fmt.toFixed(item.cost, 2)}}</text>
          </view>
        </view>

        <!-- 五金&配件 -->
        <view class="detail-section-title-center">五金&配件</view>
        <view class="hw-table">
          <!-- 表头 -->
          <view class="hw-table-header">
            <text class="hw-col-cat">部件</text>
            <text class="hw-col-name">型号</text>
            <text class="hw-col-num">数量</text>
            <text class="hw-col-num">单价</text>
            <text class="hw-col-total">总计</text>
          </view>
          <!-- 五金行 -->
          <view class="hw-table-row" 
                wx:for="{{costResult.modules[expandedModule].hardwareDetail}}" 
                wx:key="name"
                wx:if="{{item.qty > 0}}">
            <text class="hw-col-cat">{{item.category}}</text>
            <text class="hw-col-name">{{item.name}}</text>
            <text class="hw-col-num">{{item.qty}}</text>
            <text class="hw-col-num">{{item.price}}</text>
            <text class="hw-col-total">{{fmt.toFixed(item.cost, 2)}}</text>
          </view>
        </view>
      </scroll-view>

      <!-- 关闭按钮 -->
      <view class="detail-close-bar">
        <view class="detail-close-btn" bindtap="closeDetail">
          <text>关闭</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 下载链接弹窗 ========== -->
  <view class="download-modal" wx:if="{{showDownloadModal}}">
    <view class="download-modal-mask" bindtap="closeDownloadModal"></view>
    <view class="download-modal-content">
      <text class="download-modal-title">百度网盘下载链接</text>
      <text class="download-modal-desc">复制链接后请打开「百度网盘」App 粘贴访问</text>
      <view class="download-modal-link">
        <text class="download-modal-link-text selectable" user-select="true">{{downloadUrl}}</text>
      </view>
      <view class="download-modal-actions">
        <view class="download-modal-btn download-modal-btn-secondary" bindtap="closeDownloadModal">
          <text class="download-modal-btn-text-secondary">关闭</text>
        </view>
        <view class="download-modal-btn download-modal-btn-primary" bindtap="copyDownloadUrl">
          <text class="download-modal-btn-text-primary">一键复制</text>
        </view>
      </view>
    </view>
  </view>
</view>
