/* pages/design/preset/preset.wxss */

.preset-content {
  position: relative;
  z-index: 1;
  padding: 30rpx 40rpx 40rpx;
  display: flex;
  justify-content: center;
}

.preset-card {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  width: 100%;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.1);
}

.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 48rpx;
  line-height: 1.5;
}

.name-input {
  display: block;
  width: 100%;
  box-sizing: border-box;
  background: #f6f7f9;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  line-height: 1.5;
  text-align: center;
  color: #333;
  margin-bottom: 16rpx;
  min-height: 96rpx;
  -webkit-font-smoothing: antialiased;
}

.name-input:focus {
  background: #ffffff;
  border-color: #FC9700;
}

.name-input-ph {
  color: #bbb;
  font-size: 30rpx;
  font-weight: normal;
  line-height: 1.5;
}

.corner-options {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.corner-btn {
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  border: 2rpx solid #d0d0d0;
  font-size: 26rpx;
  color: #666;
  background: #fff;
}

.corner-btn.active {
  background: #333;
  color: #fff;
  border-color: #333;
}

.corner-hint {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  margin-bottom: 30rpx;
  line-height: 1.6;
  white-space: pre-line;
}

.size-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.size-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  width: 180rpx;
}

.size-input {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  border-bottom: 2rpx solid #e0e0e0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  /* 左对齐：光标永远在 placeholder 左边，不会再遮住 placeholder 中间的字 */
  text-align: left;
}

.size-input-ph {
  color: #bbb;
  font-size: 28rpx;
  font-weight: normal;
  /* 和 input 保持一致的左对齐与行高，避免 placeholder 偏上/偏下被光标切 */
  text-align: left;
  line-height: 64rpx;
}

.size-unit {
  font-size: 28rpx;
  color: #333;
  margin-left: 10rpx;
  font-weight: bold;
}

.error-msg {
  color: #e74c3c;
  font-size: 24rpx;
  text-align: center;
  margin: 20rpx 0;
}

.preset-btns {
  display: flex;
  justify-content: space-around;
  margin-top: 40rpx;
  border-top: 2rpx solid #f0f0f0;
  padding-top: 30rpx;
}

.btn-cancel {
  font-size: 32rpx;
  color: #666;
  padding: 16rpx 60rpx;
}

.btn-ok {
  font-size: 32rpx;
  color: #FC9700;
  font-weight: bold;
  padding: 16rpx 60rpx;
}
