/* pages/design/design.wxss */

.design-content {
  position: relative;
  z-index: 1;
  padding: 20rpx 32rpx 220rpx;
  box-sizing: border-box;
  width: 100%;
}

/* ===== 页面标题 ===== */
.design-header {
  display: flex;
  flex-direction: column;
  margin-bottom: 48rpx;
  padding: 0 8rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.25;
  letter-spacing: -0.8rpx;
}

.header-subtitle {
  font-size: 26rpx;
  font-weight: 500;
  color: #86868b;
  margin-top: 12rpx;
  letter-spacing: 0.2rpx;
}

/* ===== 登录提示卡片 ===== */
.login-card {
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-sizing: border-box;
  width: 100%;
}

.login-title-wrap {
  margin-bottom: 28rpx;
}

.login-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.3;
  letter-spacing: -0.5rpx;
}

.login-desc {
  display: flex;
  flex-direction: column;
  margin-bottom: 40rpx;
  gap: 6rpx;
  width: 100%;
}

.login-desc text {
  font-size: 26rpx;
  color: #6e6e73;
  line-height: 1.7;
}

.login-desc .bold {
  font-weight: 600;
  color: #1d1d1f;
}

.btn-register {
  background: #FC9700;
  border: none;
  border-radius: 50rpx;
  padding: 26rpx 0;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(252, 151, 0, 0.28);
  box-sizing: border-box;
}

.btn-register::after {
  border: none;
}

.btn-register-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1rpx;
}

/* ===== CTA 区块 ===== */
.cta-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.btn-new-design {
  background: #FC9700;
  border: none;
  border-radius: 50rpx;
  padding: 26rpx 40rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: 0 6rpx 18rpx rgba(252, 151, 0, 0.28);
  box-sizing: border-box;
}

.btn-new-design::after {
  border: none;
}

.btn-new-design:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.btn-plus {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
}

.btn-new-design-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1rpx;
}

/* ===== 已保存设计区 ===== */
.saved-section {
  padding: 0 4rpx;
  width: 100%;
  box-sizing: border-box;
}

.saved-heading {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  letter-spacing: -0.3rpx;
  margin-bottom: 20rpx;
}

.saved-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.design-item {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(60, 60, 67, 0.06);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  box-sizing: border-box;
  width: 100%;
}

.design-item:active {
  background: rgba(255, 255, 255, 0.95);
}

.design-item-info {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.design-name {
  font-size: 30rpx;
  color: #1d1d1f;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.design-delete {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(120, 120, 128, 0.12);
  flex-shrink: 0;
}

.design-delete-icon {
  color: #6e6e73;
  font-size: 22rpx;
  line-height: 1;
}

.design-delete:active {
  background: rgba(255, 59, 48, 0.15);
}

/* ===== 空状态 ===== */
.no-design {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  background: rgba(255, 255, 255, 0.75);
  border-radius: 24rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.06);
  box-sizing: border-box;
  width: 100%;
}

.no-design-text {
  font-size: 30rpx;
  color: #1d1d1f;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.no-design-hint {
  font-size: 24rpx;
  color: #86868b;
}

/* ===== 毛玻璃卡片 ===== */
.section-card {
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  border: 1rpx solid rgba(60, 60, 67, 0.06);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
  width: 100%;
}

/* ===== 删除确认弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.4);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 560rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 44rpx 36rpx 28rpx;
  text-align: center;
  box-sizing: border-box;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.12);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 12rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: #6e6e73;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.modal-btns {
  display: flex;
  gap: 16rpx;
}

.modal-btn-cancel {
  flex: 1;
  padding: 22rpx 0;
  text-align: center;
  border-radius: 40rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.18);
  font-size: 28rpx;
  font-weight: 500;
  color: #6e6e73;
}

.modal-btn-confirm {
  flex: 1;
  padding: 22rpx 0;
  text-align: center;
  border-radius: 40rpx;
  background: #FF3B30;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-btn-cancel:active,
.modal-btn-confirm:active {
  opacity: 0.85;
}
