<!--pages/knowledge/pd2dList/pd2dList.wxml-->
<wxs src="../../../utils/assets.wxs" module="assets" />
<view class="container">
  <image class="bg-image bg-image-light" src="{{assets.bg('T3')}}" mode="aspectFill" lazy-load />

  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar" style="height: {{navBarHeight}}px;">
      <view class="nav-back" bindtap="goBack">
        <text class="nav-back-icon">‹</text>
      </view>
      <text class="nav-title">PD2D 设计</text>
    </view>
  </view>

  <view class="design-content" style="padding-top: {{statusBarHeight + navBarHeight + 40}}px;">

    <view class="design-header">
      <text class="header-title">已保存的方案</text>
      <text class="header-subtitle">透视标定 · 柜体布置 · 成本透视</text>
    </view>

    <!-- 主 CTA -->
    <view class="cta-block">
      <button class="btn-new-design" bindtap="goNewDesign">
        <text class="btn-plus">+</text>
        <text class="btn-new-design-text">开始新设计</text>
      </button>
    </view>

    <!-- 列表 -->
    <view class="saved-section" wx:if="{{layouts.length > 0}}">
      <text class="saved-heading">本地保存</text>
      <view class="saved-list">
        <view class="design-item"
          wx:for="{{layouts}}" wx:key="id"
          bindtap="openLayout"
          data-id="{{item.id}}">
          <view class="design-item-info">
            <text class="design-name">{{item.name}}</text>
            <text class="design-desc">{{item.desc}}</text>
          </view>
          <view class="design-delete" catchtap="onDeleteTap" data-id="{{item.id}}">
            <text class="design-delete-icon">✕</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{layouts.length === 0}}" class="no-design">
      <text class="no-design-text">还没有保存的方案</text>
      <text class="no-design-hint">点击上方按钮，开启第一个设计</text>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showDeleteModal}}">
    <view class="modal-content">
      <view class="modal-title">是否删除该方案？</view>
      <view class="modal-desc">删除后无法恢复</view>
      <view class="modal-btns">
        <view class="modal-btn-cancel" bindtap="cancelDelete">否</view>
        <view class="modal-btn-confirm" bindtap="confirmDelete">确认删除</view>
      </view>
    </view>
  </view>
</view>
