/* pages/knowledge/pd2d/pd2d.wxss */

.page {
  width: 100vw;
  height: 100vh;
  background: #2a2a2a;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(42, 42, 42, 0.92);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 0 16rpx;
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  flex-shrink: 0;
}

.nav-back:active {
  background: rgba(255, 255, 255, 0.1);
}

.nav-back-icon {
  font-size: 52rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.5rpx;
  margin-left: 8rpx;
}

.canvas-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 16rpx;
}

.pd2d-canvas {
  border-radius: 8rpx;
}

.bottom-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(42, 42, 42, 0.95);
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn:active {
  opacity: 0.85;
}

.btn-primary {
  background: linear-gradient(135deg, #FFB140 0%, #FC9700 100%);
  color: #ffffff;
}

.btn-outline {
  background: transparent;
  color: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.btn-outline:active {
  background: rgba(255, 255, 255, 0.08);
}

.hint {
  position: absolute;
  bottom: 200rpx;
  left: 0;
  right: 0;
  text-align: center;
  pointer-events: none;
}

.hint text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.35);
}
